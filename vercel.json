{
  "buildCommand": "cd nairobi_life && chmod +x build_web.sh && ./build_web.sh",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    {
      "source": "/streets",
      "destination": "/nairobi_streets.html"
    },
    {
      "source": "/(.*)",
      "destination": "/nairobi_life.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Cache-Control", "value": "public, max-age=31536000" }
      ]
    }
  ]
}