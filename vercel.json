{
  "buildCommand": "git clone https://github.com/emscripten-core/emsdk.git /tmp/emsdk && cd /tmp/emsdk && ./emsdk install latest && ./emsdk activate latest && source ./emsdk_env.sh && cd $VERCEL_PROJECT_ROOT && make web",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/nairobi_streets.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Cache-Control", "value": "public, max-age=31536000" }
      ]
    }
  ]
}